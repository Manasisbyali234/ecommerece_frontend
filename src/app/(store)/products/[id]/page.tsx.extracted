177: export default function ProductDetailPage({ params }: PageProps) {
178:   const resolvedParams = use(params);
179:   const router = useRouter();
180:   const { addItem, openCart } = useCart();
181:   const { isInWishlist, toggleWishlist } = useWishlist();
182: 
183:   // Find product by ID
184:   const product: Product =
185:     products.find((p) => p.id === resolvedParams.id) || products[0];
186: 
187:   const galleryImages = product.images && product.images.length > 0
188:     ? product.images
189:     : [product.image];
190: 
191:   const [activeImageIndex, setActiveImageIndex] = useState(0);
192:   const [selectedColor, setSelectedColor] = useState(
193:     product.colors && product.colors.length > 0 ? product.colors[0].name : ""
194:   );
195:   const [selectedSize, setSelectedSize] = useState(
196:     product.sizes && product.sizes.length > 0 ? product.sizes[0] : ""
197:   );
198:   const [quantity, setQuantity] = useState(1);
199:   const [activeTab, setActiveTab] = useState<"features" | "specs" | "reviews">("features");
200: 
201:   // Lightbox Zoom Modal & Visual Showcase Slider States
202:   const [lightboxOpen, setLightboxOpen] = useState(false);
203:   const [lightboxIndex, setLightboxIndex] = useState(0);
204:   const [zoomLevel, setZoomLevel] = useState(1);
205:   const [showcaseSlideIndex, setShowcaseSlideIndex] = useState(0);
206: 
207:   // Shop Similar Products Slider Ref & Data
208:   const similarSliderRef = useRef<HTMLDivElement>(null);
209:   const [isSimilarHovered, setIsSimilarHovered] = useState(false);
210: 
211:   const similarProducts = useMemo(() => {
212:     let matches = products.filter(
213:       (p) => p.id !== product.id && (p.category === product.category || (product.brand && p.brand === product.brand))
214:     );
215:     if (matches.length < 6) {
216:       const fallback = products.filter((p) => p.id !== product.id && !matches.some((m) => m.id === p.id));
217:       matches = [...matches, ...fallback];
218:     }
219:     return matches;
220:   }, [product]);
221: 
222:   const handleScrollSimilar = (direction: "left" | "right") => {
223:     if (similarSliderRef.current) {
224:       const container = similarSliderRef.current;
225:       const scrollAmount = 300;
226:       if (direction === "left") {
227:         if (container.scrollLeft <= 5) {
228:           container.scrollTo({ left: container.scrollWidth, behavior: "smooth" });
229:         } else {
230:           container.scrollBy({ left: -scrollAmount, behavior: "smooth" });
231:         }
232:       } else {
233:         if (container.scrollLeft + container.clientWidth >= container.scrollWidth - 10) {
234:           container.scrollTo({ left: 0, behavior: "smooth" });
235:         } else {
236:           container.scrollBy({ left: scrollAmount, behavior: "smooth" });
237:         }
238:       }
239:     }
240:   };
241: 
242:   // Auto-Slide Interval for Similar Products Slider
243:   useEffect(() => {
244:     if (isSimilarHovered) return;
245:     const interval = setInterval(() => {
246:       handleScrollSimilar("right");
247:     }, 3200);
248: 
249:     return () => clearInterval(interval);
250:   }, [isSimilarHovered]);
251: 
252:   // Enhanced Customer Reviews State
253:   const [reviewsList, setReviewsList] = useState<ProductReview[]>(
254:     product.reviews && product.reviews.length > 0 ? product.reviews : sampleCustomerReviews
255:   );
256:   const [reviewMediaModal, setReviewMediaModal] = useState<{ type: "image" | "video"; url: string; title?: string } | null>(null);
257:   const [openAddReviewModal, setOpenAddReviewModal] = useState(false);
258: 
259:   // Review Filter & Sort States
260:   const [reviewRatingFilter, setReviewRatingFilter] = useState<number | "all">("all");
261:   const [reviewSortBy, setReviewSortBy] = useState<"recent" | "highest" | "lowest">("recent");
262: 
263:   const filteredReviews = useMemo(() => {
264:     let list = [...reviewsList];
265: 
266:     // Filter by Star Rating
267:     if (reviewRatingFilter !== "all") {
268:       list = list.filter((r) => r.rating === reviewRatingFilter);
269:     }
270: 
271:     // Sort By
272:     if (reviewSortBy === "highest") {
273:       list.sort((a, b) => b.rating - a.rating);
274:     } else if (reviewSortBy === "lowest") {
275:       list.sort((a, b) => a.rating - b.rating);
276:     }
277: 
278:     return list;
279:   }, [reviewsList, reviewRatingFilter, reviewSortBy]);
280:   const [newReview, setNewReview] = useState<{
281:     author: string;
282:     rating: number;
283:     title: string;
284:     comment: string;
285:     photos: string[];
286:     videoUrl: string | null;
287:   }>({
288:     author: "",
289:     rating: 5,
290:     title: "",
291:     comment: "",
292:     photos: [],
293:     videoUrl: null,
294:   });
295: 
296:   const handlePhotoUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
297:     const files = e.target.files;
298:     if (files && files.length > 0) {
299:       const newUrls: string[] = [];
300:       Array.from(files).forEach((file) => {
301:         const url = URL.createObjectURL(file);
302:         newUrls.push(url);
303:       });
304:       setNewReview((prev) => ({
305:         ...prev,
306:         photos: [...prev.photos, ...newUrls],
307:       }));
308:       toast.success(`${files.length} photo(s) attached to review`);
309:     }
310:   };
311: 
312:   const handleVideoUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
313:     const files = e.target.files;
314:     if (files && files.length > 0) {
315:       const videoFile = files[0];
316:       const videoUrl = URL.createObjectURL(videoFile);
317:       setNewReview((prev) => ({
318:         ...prev,
319:         videoUrl,
320:       }));
321:       toast.success("Short video review attached!");
322:     }
323:   };
324: 
325:   const handleAddReviewSubmit = (e: React.FormEvent) => {
326:     e.preventDefault();
327:     if (!newReview.author.trim() || !newReview.comment.trim()) {
328:       toast.error("Please fill in your name and review details");
329:       return;
330:     }
331:     const created: ProductReview = {
332:       id: `rev-${Date.now()}`,
333:       author: newReview.author,
334:       avatarUrl: `https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150`,
335:       verifiedBuyer: true,
336:       rating: newReview.rating,
337:       date: "Just now",
338:       title: newReview.title || "Great purchase!",
339:       comment: newReview.comment,
340:       images: newReview.photos.length > 0 ? newReview.photos : [galleryImages[0] || product.image],
341:       videoUrl: newReview.videoUrl || undefined,
342:       videoPoster: newReview.videoUrl ? (galleryImages[0] || product.image) : undefined,
343:       likes: 0,
344:     };
345: 
346:     setReviewsList((prev) => [created, ...prev]);
347:     setOpenAddReviewModal(false);
348:     setNewReview({ author: "", rating: 5, title: "", comment: "", photos: [], videoUrl: null });
349:     toast.success("Thank you! Your customer review with media has been published.");
350:   };
