855:               activeTab === "specs"
856:                 ? "border-primary text-primary"
857:                 : "border-transparent text-muted-foreground hover:text-foreground"
858:             }`}
859:           >
860:             More Information
861:           </button>
862: 
863:           <button
864:             onClick={() => setActiveTab("reviews")}
865:             className={`text-sm font-bold pb-2 border-b-2 transition-all ${
866:               activeTab === "reviews"
867:                 ? "border-primary text-primary"
868:                 : "border-transparent text-muted-foreground hover:text-foreground"
869:             }`}
870:           >
871:             Customer Reviews ({reviewsList.length})
872:           </button>
