420:   // Frequently Bought Together Combo Products calculation
421:   const comboProductsList = useMemo(() => {
422:     if (product.comboProductIds && product.comboProductIds.length > 0) {
423:       const resolved = products.filter((p) => product.comboProductIds?.includes(p.id));
424:       if (resolved.length > 0) return resolved;
425:     }
426:     // Fallback picks 1 complementary product from catalog
427:     const fallback = products.find(
428:       (p) => p.id !== product.id && p.category === product.category
429:     ) || products.find((p) => p.id !== product.id);
430:     return fallback ? [fallback] : [];
431:   }, [product]);
432: 
433:   const allComboItems = useMemo(() => [product, ...comboProductsList], [product, comboProductsList]);
434: 
435:   // Selected state for checked combo items
436:   const [checkedComboIds, setCheckedComboIds] = useState<string[]>([]);
437: 
438:   useEffect(() => {
439:     setCheckedComboIds(allComboItems.map((i) => i.id));
440:   }, [allComboItems]);
441: 
442:   const toggleComboChecked = (id: string) => {
443:     setCheckedComboIds((prev) =>
444:       prev.includes(id) ? prev.filter((i) => i !== id) : [...prev, id]
445:     );
446:   };
447: 
448:   const comboTotalPrice = useMemo(() => {
449:     return allComboItems
450:       .filter((item) => checkedComboIds.includes(item.id))
451:       .reduce((sum, item) => sum + item.price, 0);
452:   }, [allComboItems, checkedComboIds]);
453: 
454:   const comboOriginalPrice = useMemo(() => {
455:     return allComboItems
456:       .filter((item) => checkedComboIds.includes(item.id))
457:       .reduce((sum, item) => sum + (item.originalPrice || Math.round(item.price * 1.28)), 0);
458:   }, [allComboItems, checkedComboIds]);
459: 
460:   const handleAddComboToCart = () => {
461:     const itemsToAdd = allComboItems.filter((item) => checkedComboIds.includes(item.id));
462:     if (itemsToAdd.length === 0) {
463:       toast.error("Please check at least one item to add to cart");
464:       return;
465:     }
466:     itemsToAdd.forEach((item) => addItem(item, 1));
467:     toast.success(`Added ${itemsToAdd.length} combo items to your cart!`, {
468:       description: `Total: ${formatCurrency(comboTotalPrice)}`,
469:     });
470:     openCart();
