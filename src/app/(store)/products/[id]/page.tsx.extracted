874: 
875:         {/* Tab 1: About Product (Dynamic Configured Sections Layout) */}
876:         {activeTab === "features" && (
877:           <div className="space-y-10">
878:             {((product.aboutSections && product.aboutSections.length > 0)
879:               ? product.aboutSections
880:               : defaultAboutSections
881:             )
882:               .filter((sec: AboutProductSection) => sec.active !== false)
883:               .map((section: AboutProductSection) => {
884:                 switch (section.type) {
885:                   case "about-text":
886:                     return (
887:                       <div key={section.id} className="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
888:                         <div className="lg:col-span-2 space-y-4">
889:                           <div className="space-y-1">
890:                             <h3 className="text-2xl font-extrabold text-foreground tracking-tight">
891:                               {section.content.heading || `Designed for Excellence. Engineered for ${product.name}.`}
892:                             </h3>
893:                           </div>
894:                           <p className="text-sm text-muted-foreground leading-relaxed">
895:                             {section.content.description1 || `${product.description} Built with meticulous attention to detail, ${product.name} delivers an uncompromised blend of cutting-edge technology, ergonomic comfort, and enduring durability.`}
896:                           </p>
897:                           <p className="text-sm text-muted-foreground leading-relaxed">
898:                             {section.content.description2 || `Whether working from home, commuting across the city, or pursuing active goals, ${product.name} offers peak performance with zero friction.`}
899:                           </p>
900:                         </div>
901:                       </div>
902:                     );
903: 
904:                   case "highlights":
905:                     return (
906:                       <div key={section.id} className="space-y-4 pt-4 border-t">
907:                         <h4 className="text-base font-bold text-foreground flex items-center gap-2">
908:                           <Sparkles className="h-4 w-4 text-amber-500" /> {section.title}
909:                         </h4>
910:                         <ul className="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
911:                           {(section.content.items && section.content.items.length > 0
912:                             ? section.content.items
913:                             : [
914:                                 { title: "Next-Gen Speed & Ultra-Low Latency", description: "Engineered with ultra-responsive architecture for instant performance, crystal-clear audio, and zero lag." },
915:                                 { title: "Aerospace-Grade Durability & Finish", description: "Crafted with premium scratch-resistant aluminum & beryllium materials tested for long-lasting daily wear." },
916:                                 { title: "All-Day Battery Life & USB-C Quick Charge", description: "Intelligent power management delivers 35+ hours continuous usage with 10-minute quick charge boost." },
917:                                 { title: "Precision Ergonomics & Breathable Ear Cushions", description: "Biomechanically contoured headband and memory foam ear pads for fatigue-free comfort during extended work sessions." },
918:                               ]
919:                           ).map((item: { title?: string; description?: string }, idx: number) => (
920:                             <li key={idx} className="flex items-start gap-3 p-3.5 rounded-xl border bg-muted/20 hover:border-primary/30 transition-all">
921:                               <div className="h-6 w-6 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5 font-bold">
922:                                 <CheckCircle2 className="h-4 w-4 text-primary" />
923:                               </div>
924:                               <div>
925:                                 <span className="font-bold text-foreground block text-xs">{item.title}</span>
926:                                 {item.description && <span className="text-muted-foreground leading-relaxed block pt-0.5">{item.description}</span>}
927:                               </div>
928:                             </li>
929:                           ))}
930:                         </ul>
931:                       </div>
932:                     );
933: 
934:                   case "banner":
935:                     return (
936:                       <div key={section.id} className="relative overflow-hidden rounded-3xl border shadow-md group">
937:                         <img
938:                           src={section.content.bannerImage || "https://images.unsplash.com/photo-1546435770-a3e426bf472b?w=1200"}
939:                           alt="Product Showcase Banner"
940:                           className="w-full h-64 sm:h-80 object-cover group-hover:scale-102 transition-transform duration-700"
941:                         />
942:                         <div className="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent flex flex-col justify-end p-6 sm:p-10 space-y-2 text-white">
943:                           <Badge className="w-max bg-amber-500 text-slate-950 font-black text-xs uppercase tracking-wider">
944:                             {section.content.bannerBadge || "★ Metromindz Flagship Series"}
945:                           </Badge>
946:                           <h3 className="text-xl sm:text-3xl font-black tracking-tight">
947:                             {section.content.bannerTitle || "Experience Unrivaled Craftsmanship & Performance"}
948:                           </h3>
949:                           <p className="text-xs sm:text-sm text-slate-300 max-w-2xl">
950:                             {section.content.bannerSubtitle || `Every aspect of ${product.name} is engineered to elevate your daily experience with unmatched precision and style.`}
951:                           </p>
952:                         </div>
953:                       </div>
954:                     );
955: 
956:                   case "showcase":
957:                     const showcaseItems = section.content.items && section.content.items.length > 0 ? section.content.items : [
958:                       { title: "Laser-Etched Precision & Matte Finish", description: "Refined tactile finishes and premium smudge-resistant coating.", badge: "Craftsmanship", image: galleryImages[0] || product.image },
959:                       { title: "Seamless Multi-Device Instant Sync", description: "Instant 1-tap connection across laptops, smartphones, and tablet ecosystems.", badge: "Connectivity", image: galleryImages[1] || galleryImages[0] || product.image },
960:                       { title: "Smart Environmental ANC & Transparency Mode", description: "Adaptive dual-microphone noise suppression isolates external chatter.", badge: "Acoustics", image: galleryImages[2] || galleryImages[0] || product.image },
961:                     ];
962:                     const currentSlide = showcaseItems[showcaseSlideIndex % showcaseItems.length];
963: 
964:                     return (
965:                       <div key={section.id} className="space-y-4 pt-4 border-t">
966:                         <div className="flex items-center justify-between">
967:                           <h4 className="text-base font-bold text-foreground flex items-center gap-2">
968:                             <Maximize2 className="h-4 w-4 text-primary" /> {section.title}
969:                           </h4>
970:                           <div className="flex items-center gap-2">
971:                             <span className="text-xs font-bold font-mono text-muted-foreground mr-1">
972:                               {String((showcaseSlideIndex % showcaseItems.length) + 1).padStart(2, "0")} / {String(showcaseItems.length).padStart(2, "0")}
973:                             </span>
974:                             <Button size="icon" variant="outline" onClick={() => setShowcaseSlideIndex((prev) => (prev === 0 ? showcaseItems.length - 1 : prev - 1))} className="h-8 w-8 rounded-full">
975:                               <ChevronLeft className="h-4 w-4" />
976:                             </Button>
977:                             <Button size="icon" variant="outline" onClick={() => setShowcaseSlideIndex((prev) => (prev === showcaseItems.length - 1 ? 0 : prev + 1))} className="h-8 w-8 rounded-full">
978:                               <ChevronRight className="h-4 w-4" />
979:                             </Button>
980:                           </div>
981:                         </div>
982: 
983:                         <div className="relative overflow-hidden rounded-3xl border shadow-md bg-slate-950 text-white min-h-[300px] sm:min-h-[360px] flex flex-col justify-end group">
984:                           <img src={currentSlide.image || product.image} alt={currentSlide.title} className="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-all duration-700" />
985:                           <div className="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent" />
986:                           <div className="relative z-10 p-6 sm:p-8 space-y-2 max-w-2xl">
987:                             <Badge className="bg-amber-500 text-slate-950 font-black text-[10px] uppercase tracking-wider">
988:                               ★ {currentSlide.badge || "Feature"}
989:                             </Badge>
990:                             <h4 className="text-lg sm:text-2xl font-black tracking-tight leading-snug">{currentSlide.title}</h4>
991:                             <p className="text-xs sm:text-sm text-slate-300 leading-relaxed">{currentSlide.description}</p>
992:                           </div>
993:                         </div>
994:                       </div>
995:                     );
996: 
997:                   case "specs-summary":
998:                     return (
999:                       <div key={section.id} className="p-5 rounded-2xl bg-muted/20 border space-y-4 shadow-2xs">
1000:                         <div className="flex items-center justify-between border-b pb-3">
1001:                           <h4 className="text-sm font-extrabold text-foreground flex items-center gap-2">
1002:                             <CheckCircle2 className="h-4 w-4 text-emerald-500" /> {section.title}
1003:                           </h4>
1004:                         </div>
1005:                         <ul className="space-y-3 text-xs">
1006:                           {(section.content.items && section.content.items.length > 0 ? section.content.items : product.features?.map((f: string) => ({ title: f })) || []).map((item: { title?: string }, i: number) => (
1007:                             <li key={i} className="flex items-start gap-2.5 p-2 rounded-xl bg-background border hover:border-primary/30 transition-all">
1008:                               <div className="h-5 w-5 rounded-full bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
1009:                                 <Check className="h-3 w-3" />
1010:                               </div>
1011:                               <span className="font-semibold text-foreground leading-snug">{item.title}</span>
1012:                             </li>
1013:                           ))}
1014:                         </ul>
1015:                       </div>
1016:                     );
1017: 
1018:                   case "whats-in-box":
1019:                     return (
1020:                       <div key={section.id} className="p-5 rounded-2xl bg-amber-500/5 border border-amber-500/20 space-y-4 shadow-2xs">
1021:                         <div className="flex items-center justify-between border-b border-amber-500/20 pb-3">
1022:                           <h4 className="text-sm font-extrabold text-foreground flex items-center gap-2">
1023:                             <PackageCheck className="h-4 w-4 text-amber-500" /> {section.title}
1024:                           </h4>
1025:                           <Badge className="bg-amber-500 text-slate-950 text-[10px] font-bold">
1026:                             Retail Packaging
1027:                           </Badge>
1028:                         </div>
1029:                         <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
1030:                           {(section.content.items || [
1031:                             { title: `${product.name} Master Unit`, subtitle: "Main Device", qty: "1×" },
1032:                             { title: "USB-C Fast Cable", subtitle: "High-Speed Sync & Charge", qty: "1×" },
1033:                             { title: "Warranty Registration Card", subtitle: "1-Year Official Seal", qty: "1×" },
1034:                             { title: "Quick Setup Manual", subtitle: "User Safety Guide", qty: "1×" },
1035:                           ]).map((boxItem: { title?: string; subtitle?: string; qty?: string }, i: number) => (
1036:                             <div key={i} className="flex items-center gap-3 p-3 rounded-xl bg-background border shadow-2xs">
1037:                               <div className="h-8 w-8 rounded-lg bg-amber-500/10 text-amber-600 flex items-center justify-center shrink-0 font-bold">
1038:                                 {boxItem.qty || "1×"}
1039:                               </div>
1040:                               <div className="min-w-0">
1041:                                 <span className="font-bold text-foreground block text-xs truncate">{boxItem.title}</span>
1042:                                 {boxItem.subtitle && <span className="text-[10px] text-muted-foreground block">{boxItem.subtitle}</span>}
1043:                               </div>
1044:                             </div>
1045:                           ))}
1046:                         </div>
1047:                       </div>
1048:                     );
1049: 
1050:                   default:
1051:                     return null;
1052:                 }
1053:               })}
1054:           </div>
1055:         )}
1056: 
1057:         {/* Tab 2: Technical Specifications / More Information Accordion */}
1058:         {activeTab === "specs" && (
1059:           <div className="max-w-3xl space-y-4">
1060:             <div className="flex items-center justify-between">
1061:               <h3 className="text-lg font-bold text-foreground">Additional Product Information</h3>
1062:             </div>
1063: 
1064:             <Accordion type="multiple" defaultValue={["general-info", "tech-specs", "logistics"]} className="w-full space-y-3">
1065:               {/* Accordion 1: General Product Identifiers */}
1066:               <AccordionItem value="general-info" className="border rounded-xl px-4 bg-background shadow-2xs">
1067:                 <AccordionTrigger className="hover:no-underline font-bold text-sm">
1068:                   <span>General Product Information & Identification</span>
1069:                 </AccordionTrigger>
1070:                 <AccordionContent className="pt-2 pb-4">
1071:                   <div className="divide-y rounded-lg border overflow-hidden">
1072:                     <div className="grid grid-cols-3 p-3 text-xs bg-amber-500/10 dark:bg-amber-500/5">
1073:                       <span className="font-bold text-foreground">Product SKU Code</span>
1074:                       <span className="col-span-2 font-mono font-bold text-amber-600 dark:text-amber-400">
1075:                         {product.sku}
1076:                       </span>
1077:                     </div>
1078:                     <div className="grid grid-cols-3 p-3 text-xs bg-background">
1079:                       <span className="font-medium text-muted-foreground">Product Name</span>
1080:                       <span className="col-span-2 font-semibold text-foreground">{product.name}</span>
1081:                     </div>
1082:                     <div className="grid grid-cols-3 p-3 text-xs bg-muted/20">
1083:                       <span className="font-medium text-muted-foreground">Brand Manufacturer</span>
1084:                       <span className="col-span-2 font-semibold text-foreground">{product.brand || "Metromindz"}</span>
1085:                     </div>
1086:                     <div className="grid grid-cols-3 p-3 text-xs bg-background">
1087:                       <span className="font-medium text-muted-foreground">Category</span>
1088:                       <span className="col-span-2 font-semibold text-foreground">{product.category}</span>
1089:                     </div>
1090:                     <div className="grid grid-cols-3 p-3 text-xs bg-muted/20">
1091:                       <span className="font-medium text-muted-foreground">Target Audience</span>
1092:                       <span className="col-span-2 font-semibold text-foreground">{product.gender || "Unisex"}</span>
1093:                     </div>
1094:                   </div>
1095:                 </AccordionContent>
1096:               </AccordionItem>
1097: 
1098:               {/* Accordion 2: Technical Specifications Matrix */}
1099:               <AccordionItem value="tech-specs" className="border rounded-xl px-4 bg-background shadow-2xs">
1100:                 <AccordionTrigger className="hover:no-underline font-bold text-sm">
1101:                   <span>Technical & Hardware Specifications</span>
1102:                 </AccordionTrigger>
1103:                 <AccordionContent className="pt-2 pb-4">
1104:                   <div className="divide-y rounded-lg border overflow-hidden">
1105:                     {product.specs && Object.keys(product.specs).length > 0 ? (
1106:                       Object.entries(product.specs).map(([key, val], idx) => (
1107:                         <div
1108:                           key={key}
1109:                           className={`grid grid-cols-3 p-3 text-xs ${
1110:                             idx % 2 === 0 ? "bg-muted/20" : "bg-background"
1111:                           }`}
1112:                         >
1113:                           <span className="font-semibold text-foreground">{key}</span>
1114:                           <span className="col-span-2 text-muted-foreground font-mono">{val}</span>
1115:                         </div>
1116:                       ))
1117:                     ) : (
1118:                       <>
1119:                         <div className="grid grid-cols-3 p-3 text-xs bg-muted/20">
1120:                           <span className="font-semibold text-foreground">Driver Unit</span>
1121:                           <span className="col-span-2 text-muted-foreground font-mono">40mm Beryllium Dynamic</span>
1122:                         </div>
1123:                         <div className="grid grid-cols-3 p-3 text-xs bg-background">
1124:                           <span className="font-semibold text-foreground">Frequency Response</span>
1125:                           <span className="col-span-2 text-muted-foreground font-mono">20Hz - 40,000Hz</span>
1126:                         </div>
1127:                         <div className="grid grid-cols-3 p-3 text-xs bg-muted/20">
1128:                           <span className="font-semibold text-foreground">Connectivity</span>
1129:                           <span className="col-span-2 text-muted-foreground font-mono">Bluetooth 5.3 (AAC, aptX HD)</span>
1130:                         </div>
1131:                       </>
1132:                     )}
1133:                   </div>
1134:                 </AccordionContent>
1135:               </AccordionItem>
1136: 
1137:               {/* Accordion 3: Shipping & Guarantee Policies */}
1138:               <AccordionItem value="logistics" className="border rounded-xl px-4 bg-background shadow-2xs">
1139:                 <AccordionTrigger className="hover:no-underline font-bold text-sm">
1140:                   <span>Service Policies, Warranty & Return Terms</span>
1141:                 </AccordionTrigger>
1142:                 <AccordionContent className="pt-2 pb-4">
1143:                   <div className="divide-y rounded-lg border overflow-hidden text-xs">
1144:                     <div className="grid grid-cols-3 p-3 bg-muted/20">
1145:                       <span className="font-semibold text-foreground">Cash on Delivery</span>
1146:                       <span className="col-span-2 font-semibold text-emerald-600 dark:text-emerald-400">
1147:                         {product.codAvailable !== false
1148:                           ? product.codText || "✓ Available across 19,000+ pincodes"
1149:                           : "✕ Online Payment Only"}
1150:                       </span>
1151:                     </div>
1152:                     <div className="grid grid-cols-3 p-3 bg-background">
1153:                       <span className="font-semibold text-foreground">Return Window</span>
1154:                       <span className="col-span-2 text-muted-foreground">
1155:                         {product.returnAvailable !== false
1156:                           ? product.returnText || "7 Days Easy Money-Back Return Policy"
1157:                           : "Non-Returnable Item"}
1158:                       </span>
1159:                     </div>
1160:                     <div className="grid grid-cols-3 p-3 bg-muted/20">
1161:                       <span className="font-semibold text-foreground">Exchange / Replacement</span>
1162:                       <span className="col-span-2 text-muted-foreground">
1163:                         {product.exchangeAvailable !== false
1164:                           ? product.exchangeText || "Free Size / Color Variant Exchange"
1165:                           : "Standard Manufacturer Terms"}
1166:                       </span>
1167:                     </div>
1168:                     <div className="grid grid-cols-3 p-3 bg-background">
1169:                       <span className="font-semibold text-foreground">Manufacturer Warranty</span>
1170:                       <span className="col-span-2 font-semibold text-foreground">
1171:                         {product.warrantyPeriod || "1 Year Official Brand Warranty"}
1172:                       </span>
1173:         {/* Tab 3: Customer Reviews (Rich UI with Avatars, Photos, Videos & Rating Breakdown) */}
1174:         {activeTab === "reviews" && (
1175:           <div className="max-w-4xl space-y-8">
1176:             {/* Rating Breakdown & Header */}
1177:             <div className="grid grid-cols-1 md:grid-cols-3 gap-6 p-6 rounded-2xl border bg-muted/20 items-center">
