1359:       </div>
1360: 
1361:       {/* "Shop Similar Products" Slider Section */}
1362:       <div className="space-y-4 pt-8 border-t">
1363:         <div className="flex items-center justify-between">
1364:           <div>
1365:             <h2 className="text-xl sm:text-2xl font-bold tracking-tight text-foreground flex items-center gap-2">
1366:               Shop Similar Products
1367:             </h2>
1368:           </div>
1369: 
1370:           {/* Slider Navigation Arrow Controls */}
1371:           <div className="flex items-center gap-2">
1372:             <Button
1373:               variant="outline"
1374:               size="icon"
1375:               onClick={() => handleScrollSimilar("left")}
1376:               className="h-8 w-8 rounded-full border shadow-2xs hover:bg-muted cursor-pointer"
1377:               aria-label="Scroll Similar Products Left"
1378:             >
1379:               <ChevronLeft className="h-4 w-4" />
1380:             </Button>
1381:             <Button
1382:               variant="outline"
1383:               size="icon"
1384:               onClick={() => handleScrollSimilar("right")}
1385:               className="h-8 w-8 rounded-full border shadow-2xs hover:bg-muted cursor-pointer"
1386:               aria-label="Scroll Similar Products Right"
1387:             >
1388:               <ChevronRight className="h-4 w-4" />
1389:             </Button>
1390:           </div>
1391:         </div>
1392: 
1393:         {/* Scrollable Products Carousel Slider Track */}
1394:         <div
1395:           ref={similarSliderRef}
1396:           onMouseEnter={() => setIsSimilarHovered(true)}
1397:           onMouseLeave={() => setIsSimilarHovered(false)}
1398:           className="flex items-stretch gap-4 overflow-x-auto scrollbar-none scroll-smooth pb-3 pt-1 -mx-2 px-2"
1399:           style={{ scrollSnapType: "x mandatory" }}
1400:                               </button>
1401:                             )}
1402:                           </div>
1403:                         )}
1404:                       </CardContent>
1405:                     </Card>
1406:                 ))}
1407:               </div>
1408:             )}
1409:             </div>
1410:           </div>
1411:         )}
1412:       </div>
1413: 
1414:       {/* "Shop Similar Products" Slider Section */}
1415:       <div className="space-y-4 pt-8 border-t">
1416:         <div className="flex items-center justify-between">
1417:           <div>
1418:             <h2 className="text-xl sm:text-2xl font-bold tracking-tight text-foreground flex items-center gap-2">
1419:               Shop Similar Products
1420:             )}
1421:             </div>
1422:           </div>
1423:         )}
1424:       </div>
1425: 
1426:       {/* Amazon-Style Frequently Bought Together / Combo Products Section */}
1427:       <div className="space-y-6 pt-8 border-t">
1428:         <div className="flex items-center justify-between">
1429:           <h2 className="text-xl sm:text-2xl font-extrabold tracking-tight text-foreground flex items-center gap-2">
1430:             Frequently bought together
1431:           </h2>
1432:           <Badge variant="outline" className="text-xs font-bold text-amber-600 dark:text-amber-400 border-amber-500/30 bg-amber-500/10">
1433:             Combo Bundle Deal
1434:           </Badge>
1435:         </div>
1436: 
1437:         <div className="p-4 sm:p-6 rounded-2xl border bg-background shadow-xs space-y-6">
1438:           <div className="flex flex-col lg:flex-row items-center lg:items-center justify-between gap-6">
1439:             {/* Left Items Row with Plus signs */}
1440:             <div className="flex items-center gap-3 sm:gap-4 flex-wrap flex-1 min-w-0">
1441:               {allComboItems.map((item, idx) => {
1442:                 const isChecked = checkedComboIds.includes(item.id);
1443:                 const isCurrentProduct = item.id === product.id;
1444:                 const mrp = item.originalPrice || Math.round(item.price * 1.28);
1445: 
1446:                 return (
1447:                   <div key={item.id} className="flex items-center gap-3 sm:gap-4">
1448:                     {/* Item Card */}
1449:                     <div className="flex flex-col gap-2 p-3 border rounded-xl bg-slate-50/50 dark:bg-slate-900/50 w-36 sm:w-48 shrink-0 transition-all hover:border-amber-500/50">
1450:                       <div className="relative aspect-square overflow-hidden rounded-lg bg-background border">
1451:                         <img
1452:                           src={item.image}
1453:                           alt={item.name}
1454:                           className="h-full w-full object-cover"
1455:                         />
1456:                         <div className="absolute top-2 left-2 z-10">
1457:                           <input
1458:                             type="checkbox"
1459:                             checked={isChecked}
1460:                             onChange={() => toggleComboChecked(item.id)}
1461:                             className="h-4 w-4 rounded accent-amber-500 cursor-pointer"
1462:                           />
1463:                         </div>
1464:                       </div>
1465: 
1466:                       <div className="space-y-1">
1467:                         <div className="text-[11px] font-bold text-muted-foreground truncate">
1468:                           {isCurrentProduct ? "This item:" : item.category}
1469:                         </div>
1470:                         <Link href={`/products/${item.id}`}>
1471:                           <h4 className="text-xs font-bold text-foreground line-clamp-2 hover:text-amber-600 transition-colors">
1472:                             {item.name}
1473:                           </h4>
1474:                         </Link>
1475:                         <div className="flex items-baseline gap-1.5 flex-wrap">
1476:                           <span className="text-xs font-extrabold text-slate-900 dark:text-slate-100">
1477:                             {formatCurrency(item.price)}
1478:                           </span>
1479:                           <span className="text-[10px] line-through text-muted-foreground">
1480:                             {formatCurrency(mrp)}
1481:                           </span>
1482:                         </div>
1483:                       </div>
1484:                     </div>
1485: 
1486:                     {/* Plus separator icon */}
1487:                     {idx < allComboItems.length - 1 && (
1488:                       <div className="h-8 w-8 rounded-full bg-muted flex items-center justify-center text-muted-foreground font-bold shrink-0">
1489:                         <Plus className="h-4 w-4" />
1490:                       </div>
1491:                     )}
1492:                   </div>
1493:                 );
1494:               })}
1495:             </div>
1496: 
1497:             {/* Right Summary & Add to Cart Box */}
1498:             <div className="w-full lg:w-72 shrink-0 p-4 border rounded-xl bg-amber-500/5 dark:bg-amber-500/10 border-amber-500/20 space-y-3 flex flex-col justify-between">
1499:               <div>
1500:                 <div className="text-xs text-muted-foreground font-medium">Total price:</div>
1501:                 <div className="flex items-baseline gap-2 flex-wrap mt-0.5">
1502:                   <span className="text-xl font-extrabold text-foreground">
1503:                     {formatCurrency(comboTotalPrice)}
1504:                   </span>
1505:                   {comboOriginalPrice > comboTotalPrice && (
1506:                     <span className="text-xs line-through text-muted-foreground font-medium">
1507:                       {formatCurrency(comboOriginalPrice)}
1508:                     </span>
1509:                   )}
1510:                 </div>
1511:                 {comboOriginalPrice > comboTotalPrice && (
1512:                   <div className="text-[11px] font-bold text-amber-600 dark:text-amber-400 mt-1">
1513:                     Save {formatCurrency(comboOriginalPrice - comboTotalPrice)} on this bundle
1514:                   </div>
1515:                 )}
1516:               </div>
1517: 
1518:               <Button
1519:                 onClick={handleAddComboToCart}
1520:                 disabled={checkedComboIds.length === 0}
1521:                 className="w-full h-10 font-bold text-xs bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-xl shadow-xs gap-1.5 cursor-pointer"
1522:               >
1523:                 <ShoppingBag className="h-4 w-4" />
1524:                 <span>
1525:                   {checkedComboIds.length === 2
1526:                     ? "Add both to Cart"
1527:                     : `Add all ${checkedComboIds.length} to Cart`}
1528:                 </span>
1529:               </Button>
1530: 
1531:               <div className="text-[10px] text-muted-foreground flex items-center gap-1.5">
1532:                 <ShieldCheck className="h-4 w-4 text-amber-500 shrink-0" />
1533:                 <span>These items are dispatched together in single combo shipping.</span>
1534:               </div>
1535:             </div>
1536:           </div>
1537:         </div>
1538:       </div>
1539: 
1540:       {/* "Shop Similar Products" Slider Section */}
